---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign groups = "pages,apps,guides" | split: "," %}
{%- for g in groups %}
{%- for p in site.data.sitemap[g] %}
{%- if p.xml %}
  <url><loc>{{ p.url | absolute_url | xml_escape }}</loc></url>
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- assign items = site.items | sort: "date" | reverse %}
{%- for it in items %}
  <url><loc>{{ it.url | absolute_url | xml_escape }}</loc><lastmod>{{ it.date | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
